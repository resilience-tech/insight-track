# Public hostname. Do not include a scheme, path, or port.
APP_DOMAIN=origin-insight.blendology.com
HAPROXY_UID=1000
HAPROXY_GID=1000

POSTGRES_PASSWORD=replace-with-a-random-postgres-password
APP_DATABASE_PASSWORD=replaceWithRandomUrlSafeAlphanumericText
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-admin-password
KEYCLOAK_DATABASE_PASSWORD=replace-with-a-random-keycloak-database-password
CLICKHOUSE_PASSWORD=replace-with-a-random-clickhouse-password
TELEMETRY_API_TOKEN=replace-with-at-least-32-random-characters
# Public ingestion key used by monitored applications. Keep it different from
# TELEMETRY_API_TOKEN, which remains an internal service credential.
OTEL_INGEST_TOKEN=replace-with-a-random-ingestion-token
# Exact origin or a controlled wildcard accepted by the browser OTLP receiver.
OTEL_CORS_ALLOWED_ORIGIN=https://*.blendologyapps.co.uk
LOG_LEVEL=info
