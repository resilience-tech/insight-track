HTTP_ADDR=:8080
DATABASE_URL=postgres://app_login:app@localhost:5432/project_tenancy?sslmode=disable
DATABASE_ROLE=app_runtime

# oidc is required outside local development.
AUTH_MODE=oidc
# Set only with AUTH_MODE=dev in an isolated local environment.
ALLOW_DEV_AUTH=false
OIDC_ISSUER=http://localhost:8081/realms/project-tenancy
OIDC_AUDIENCE=project-tenancy-api
OIDC_JWKS_URL=http://localhost:8081/realms/project-tenancy/protocol/openid-connect/certs

# Local invitations are written to the API log. Replace this adapter in production.
INVITATION_BASE_URL=http://localhost:3000/invitations/accept
INVITATION_DELIVERY=log
LOG_LEVEL=info
